# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# CopilotX Proxy Configuration
VITE_AI_API_URL=http://127.0.0.1:24680
