/**
 * Convert image to base64
 */
function imageToBase64(filePath) {
    const fileBuffer = fs.readFileSync(filePath);
    return fileBuffer.toString('base64');
}

/**
 * Call Vision API (Gemini or Custom)
 */
async function callGeminiVision(imageBase64, prompt) {
    try {
        if (USE_CUSTOM_API) {
            console.log(`[OCR] Using Custom API: ${ANTHROPIC_BASE_URL} Model: ${ANTHROPIC_MODEL}`);

            // Construct Anthropic-compatible message
            const messages = [
                {
                    role: 'user',
                    content: [
                        {
                            type: 'image',
                            source: {
                                type: 'base64',
                                media_type: 'image/jpeg',
                                data: imageBase64
                            }
                        },
                        {
                            type: 'text',
                            text: prompt
                        }
                    ]
                }
            ];

            const response = await axios.post(
                `${ANTHROPIC_BASE_URL}/v1/messages`,
                {
                    model: ANTHROPIC_MODEL,
                    max_tokens: 8192,
                    messages: messages
                },
                {
                    headers: {
                        'x-api-key': ANTHROPIC_AUTH_TOKEN,
                        'anthropic-version': '2023-06-01',
                        'Content-Type': 'application/json'
                    }
                }
            );

            // Handle Anthropic response format
            if (response.data && response.data.content && Array.isArray(response.data.content)) {
                // Find the content block of type 'text'
                const textBlock = response.data.content.find(block => block.type === 'text');
                if (textBlock && textBlock.text) {
                    return textBlock.text;
                }

                // Fallback: Check if first element works (legacy support)
                if (response.data.content[0] && response.data.content[0].text) {
                    return response.data.content[0].text;
                }
            }

            console.log('Received Response Data:', JSON.stringify(response.data, null, 2));
            throw new Error('Unexpected response format from Custom API');

        } else {
            // Standard Google Gemini API
            const response = await axios.post(
                `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${GEMINI_API_KEY}`,
                {
                    contents: [
                        {
                            parts: [
                                {
                                    inlineData: {
                                        mimeType: 'image/jpeg',
                                        data: imageBase64
                                    }
                                },
                                {
                                    text: prompt
                                }
                            ]
                        }
                    ]
                }
            );

            const content = response.data.candidates[0].content.parts[0].text;
            return content;
        }
    } catch (error) {
        const errorData = error.response && error.response.data ? error.response.data : null;
        const errorMsg = error.message;
        console.error('API Error:', errorData || errorMsg);
        throw new Error('OCR processing failed: ' + (errorData ? JSON.stringify(errorData) : errorMsg));
    }
}

/**
 * Parse JSON from Gemini response
 */
function extractJSON(text) {
    try {
        // Clean the response - remove markdown code blocks if present
        let cleanText = text.trim();
        if (cleanText.startsWith('```json')) {
            cleanText = cleanText.replace(/^```json\s*\n?/, '').replace(/\n?```\s*$/, '');
        } else if (cleanText.startsWith('```')) {
            cleanText = cleanText.replace(/^```\s*\n?/, '').replace(/\n?```\s*$/, '');
        }

        // Try to find JSON in the response (handle both objects and arrays)
        const jsonMatch = cleanText.match(/[\{\[][\s\S]*[\}\]]/);
        if (jsonMatch) {
            const jsonStr = jsonMatch[0];
            return JSON.parse(jsonStr);
        }

        // If we can't find valid JSON, throw usage error
        throw new Error('No JSON found in response');
    } catch (error) {
        console.error('JSON Parse Error:', error);
        console.error('Raw text:', text);
        // Throw an error object with raw text property if possible, 
        // or just include it in message but that's messy. 
        // Better to attach it.
        const e = new Error('Failed to parse OCR response: ' + error.message);
        e.rawText = text;
        throw e;
    }
}

function toNumber(value, fallback = 0) {
    const n = Number(value);
    return Number.isFinite(n) ? n : fallback;
}

function sanitizeOcrItems(items) {
    if (!Array.isArray(items)) return [];
    return items
        .map((item) => {
            const quantity = Math.max(1, toNumber(item.quantity, 1));
            const total = toNumber(item.total, 0);
            const unitPriceRaw = toNumber(item.unit_price, NaN);
            const unitPrice = Number.isFinite(unitPriceRaw) ? unitPriceRaw : (quantity > 0 ? total / quantity : 0);
            return {
                product_name: String(item.product_name || item.name || item.description || '').trim(),
                quantity,
                unit_price: unitPrice,
                total: total || unitPrice * quantity,
                brand: String(item.brand || '').trim(),
                category: String(item.category || '').trim(),
                description: String(item.description || '').trim()
            };
        })
        .filter((item) => item.product_name);
}

/**
 * OCR Invoice Processing
 * POST /api/ocr/invoice
 */
app.post('/api/ocr/invoice', upload.single('image'), async (req, res) => {
    console.log('[OCR] /api/ocr/invoice called - from', req.ip, 'file:', req.file && req.file.originalname);
    try {
        if (!req.file) {
            return res.status(400).json({ error: 'No image provided' });
        }

        const imageBase64 = imageToBase64(req.file.path);

        const prompt = `
        You are extracting structured purchase invoice data for accounting.
        Read the full invoice carefully and return complete JSON.
        IMPORTANT:
        - Extract ALL visible line items from the item table, not just first row.
        - Keep item names exactly as seen (do not shorten).
        - Parse quantity and unit price as numbers.
        - If only line total is shown, infer unit_price = total / quantity.
        - If quantity is missing, use 1.
        - invoice_date must be a string in the same visible format if uncertain.
        - Return only valid JSON with no markdown.
        
        JSON format:
        {
            "supplier_name": "name of the supplier/company",
            "invoice_number": "invoice or reference number",
            "invoice_date": "date of invoice",
            "items": [
                {
                    "product_name": "name of product",
                    "quantity": number,
                    "unit_price": number,
                    "total": number,
                    "brand": "brand name if visible",
                    "category": "infer product category (e.g., Electronics, Groceries, Stationery, Clothing, etc.)",
                    "description": "brief product description if available"
                }
            ],
            "subtotal": number,
            "tax_amount": number,
            "discount_amount": number,
            "total_amount": number
        }
        `;

        const geminiResponse = await callGeminiVision(imageBase64, prompt);
        const parsedData = extractJSON(geminiResponse);
        parsedData.items = sanitizeOcrItems(parsedData.items);

        // Retry once with a line-item focused prompt if main extraction missed rows.
        if (!parsedData.items.length) {
            const itemsPrompt = `
            Extract only invoice line items from this image.
            Return JSON:
            {
              "items": [
                {
                  "product_name": "exact item name",
                  "quantity": number,
                  "unit_price": number,
                  "total": number,
                  "brand": "",
                  "category": "",
                  "description": ""
                }
              ]
            }
            Rules:
            - Include every visible row from the table.
            - If quantity missing, use 1.
            - If unit_price missing but total exists, set unit_price = total / quantity.
            - Return only valid JSON.
            `;
            const itemOnlyResponse = await callGeminiVision(imageBase64, itemsPrompt);
            const itemOnlyParsed = extractJSON(itemOnlyResponse);
            const fallbackItems = sanitizeOcrItems(itemOnlyParsed.items);
            if (fallbackItems.length) {
                parsedData.items = fallbackItems;
            }
        }

        parsedData.subtotal = toNumber(parsedData.subtotal, 0);
        parsedData.tax_amount = toNumber(parsedData.tax_amount, 0);
        parsedData.discount_amount = toNumber(parsedData.discount_amount, 0);
        parsedData.total_amount = toNumber(parsedData.total_amount, 0);

        // Clean up uploaded file
        fs.unlink(req.file.path, () => { });

        res.json({
            success: true,
            data: parsedData
        });
    } catch (error) {
        // Clean up uploaded file
        if (req.file) {
            fs.unlink(req.file.path, () => { });
        }

        res.status(500).json({
            error: error.message,
            raw_text: error.rawText || null,
            success: false
        });
    }
});

