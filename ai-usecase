/**
 * Sync Products from Receipt
 * POST /api/ocr/sync-products
 * Creates missing products or updates quantities
 */
app.post('/api/ocr/sync-products', express.json(), async (req, res) => {
    try {
        const { items, store_id, operation } = req.body;

        if (!items || !Array.isArray(items)) {
            return res.status(400).json({ error: 'Items array required', success: false });
        }

        if (!store_id) {
            return res.status(400).json({ error: 'Store ID required', success: false });
        }

        if (!operation || !['purchase', 'sales'].includes(operation)) {
            return res.status(400).json({ error: 'Operation must be "purchase" or "sales"', success: false });
        }

        const results = [];

        for (const item of items) {
            const result = {
                product_name: item.product_name,
                quantity: item.quantity || 1,
                action: null,
                message: null
            };

            try {
                // For now, just return the item data
                // The PHP app will handle product creation/updates
                result.action = 'pending';
                result.message = 'Ready for product sync';
                result.unit_price = item.unit_price || item.price || 0;
            } catch (err) {
                result.action = 'error';
                result.message = err.message;
            }

            results.push(result);
        }

        res.json({
            success: true,
            data: {
                items: results,
                store_id: store_id,
                operation: operation
            }
        });
    } catch (error) {
        res.status(500).json({
            error: error.message,
            success: false
        });
    }
});

